# --- GitHub Models (required) ---
# Fine-grained GitHub token with the "Models" permission. Stays server-side; never sent to the browser.
GITHUB_TOKEN=

# Model slug from the GitHub Models catalog. GPT-5.5 is multimodal + a reasoning model.
MODEL=openai/gpt-5.5

# --- Server ---
PORT=3000

# Number of representative photos sent to the model per day.
MAX_PHOTOS_PER_DAY=6

# --- Reverse geocoding (OpenStreetMap Nominatim) ---
# Nominatim asks for a contact string in the User-Agent. Put an email or app URL here.
NOMINATIM_USER_AGENT=auto-journal-web (set-your-contact@example.com)

# --- WHOOP (optional) ---
# Paste a WHOOP OAuth access token to pull activity/recovery/sleep. See README for how to obtain one.
WHOOP_ACCESS_TOKEN=
