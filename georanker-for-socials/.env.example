# --- Required for the LIVE bot only (npm run dev / start) ---
# Not needed for the safe export workflow (npm run process-export).
# The WhatsApp group the bot listens to and posts in.
# Discover it with `npm run list-groups`. Format: "<number>-<number>@g.us".
GROUP_JID=1234567890-1600000000@g.us

# GitHub PAT with the "models" scope, used for GitHub Models vision inference.
# Required unless EXTRACTOR=disabled.
GITHUB_TOKEN=ghp_your_token_here

# --- Optional (sensible defaults shown) ---
# GitHub Models inference endpoint.
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# Vision-capable model id on GitHub Models.
VISION_MODEL=openai/gpt-4o
# Image score extractor: "github-models" or "disabled" (text-only fallback).
EXTRACTOR=github-models

# IANA timezone used to group submissions into a game day.
TIMEZONE=Europe/London

# File locations.
ROSTER_PATH=config/roster.json
DB_PATH=data/georanker.sqlite
AUTH_STATE_DIR=auth_state

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
