# --- Required for the LIVE bot only (npm run dev / start) ---
# Not needed for the safe export workflow (npm run process-export).
# The WhatsApp group the bot listens to and posts in.
# Discover it with `npm run list-groups`. Format: "<number>-<number>@g.us".
GROUP_JID=1234567890-1600000000@g.us

# --- Required for the TELEGRAM bot only (npm run telegram) ---
# Fully automated, zero WhatsApp ban risk. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# The target group's chat id (e.g. -1001234567890). See the README for how to find it.
TELEGRAM_CHAT_ID=-1001234567890

# GitHub PAT with the "models" scope, used for GitHub Models vision inference.
# REQUIRED: scoring is screenshot-only, so pictures must be read by the model.
GITHUB_TOKEN=ghp_your_token_here

# --- Optional (sensible defaults shown) ---
# GitHub Models inference endpoint.
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# Vision-capable model id on GitHub Models.
VISION_MODEL=openai/gpt-4o
# Image score extractor: "github-models" or "disabled". Scoring is screenshot-only;
# with "disabled" no scores are read and every player is marked DQ.
EXTRACTOR=github-models

# IANA timezone used to group submissions into a game day.
TIMEZONE=Europe/London

# File locations.
ROSTER_PATH=config/roster.json
DB_PATH=data/georanker.sqlite
AUTH_STATE_DIR=auth_state

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# --- WEB DASHBOARD / AZURE HOSTING (npm run serve / npm start) ---
# Port the web server listens on. Azure App Service injects PORT automatically.
PORT=8080
# Public HTTPS base URL of the deployed app. When set alongside the Telegram
# vars, the hosted process registers a Telegram webhook at
# <PUBLIC_URL>/telegram/webhook and receives updates live (no long-polling).
# Leave blank for local-only dashboards. e.g. https://your-app.azurewebsites.net
PUBLIC_URL=
# Secret token Telegram must echo back on each webhook call (any random string).
TELEGRAM_WEBHOOK_SECRET=
# Shared secret that protects POST /api/upload-export AND unlocks the dashboard's
# "Upload a WhatsApp export" panel. Set it to a long random string to enable
# uploading the WhatsApp .zip straight from the browser. Leave blank to disable.
ADMIN_TOKEN=
